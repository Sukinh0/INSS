# Sem estas configurações, modo local (sem sincronização entre aparelhos).
# Configure-as também em Vercel > Settings > Environment Variables.
# Firebase Web API key não é segredo de servidor, mas NÃO inclua credenciais de Service Account.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
